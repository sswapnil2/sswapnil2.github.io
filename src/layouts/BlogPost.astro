---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
}

const { title, description, date, tags } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const readingTime = '5 min read';
---

<BaseLayout title={`${title} | Swapnil Shindemeshram`} description={description}>
  <article class="blog-post">
    <header class="post-header">
      <a href="/blog" class="back-link">← All posts</a>

      <div class="meta">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span class="separator">·</span>
        <span>{readingTime}</span>
      </div>

      <h1>{title}</h1>

      <p class="description">{description}</p>

      {tags && tags.length > 0 && (
        <div class="tags">
          {tags.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <hr />

    <div class="post-content">
      <slot />
    </div>

    <hr />

    <footer class="post-footer">
      <div class="author">
        <div class="author-info">
          <p class="author-name">Swapnil Shindemeshram</p>
          <p class="author-bio">Team Lead (Backend Engineering) at CleverTap. Writing about distributed systems, engineering leadership, and building products at scale.</p>
        </div>
      </div>
      <a href="/blog" class="back-link">← Back to all posts</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .blog-post {
    padding-top: var(--spacing-md);
  }

  .back-link {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    text-decoration: none;
    display: inline-block;
    margin-bottom: var(--spacing-lg);
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .post-header {
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }

  .meta {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
  }

  .separator {
    margin: 0 0.5rem;
    color: var(--color-text-light);
  }

  .post-header h1 {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-md);
    max-width: 100%;
  }

  .description {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    max-width: 540px;
    margin: 0 auto var(--spacing-md);
    line-height: 1.6;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .tag {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-accent);
    background: rgba(26, 137, 23, 0.08);
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
  }

  hr {
    margin: var(--spacing-xl) 0;
  }

  .post-content {
    line-height: 1.85;
  }

  .post-content :global(h2) {
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
  }

  .post-content :global(h3) {
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-sm);
  }

  .post-content :global(p) {
    margin-bottom: var(--spacing-md);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: var(--spacing-md);
    padding-left: var(--spacing-lg);
  }

  .post-content :global(li) {
    margin-bottom: var(--spacing-xs);
  }

  .post-content :global(pre) {
    margin: var(--spacing-lg) 0;
  }

  .post-content :global(blockquote) {
    margin: var(--spacing-lg) 0;
  }

  .post-content :global(img) {
    margin: var(--spacing-lg) 0;
    display: block;
  }

  .post-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: rgba(26, 137, 23, 0.4);
    text-underline-offset: 3px;
  }

  .post-content :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }

  .post-footer {
    padding-top: var(--spacing-md);
  }

  .author {
    display: flex;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
    padding: var(--spacing-md);
    background: var(--color-bg-secondary);
    border-radius: 8px;
  }

  .author-info {
    flex: 1;
  }

  .author-name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: var(--spacing-xs);
  }

  .author-bio {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 600px) {
    .post-header h1 {
      font-size: 2rem;
    }

    .description {
      font-size: 1.1rem;
    }
  }
</style>
