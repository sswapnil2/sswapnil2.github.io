---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const projects = [
  {
    title: 'Django Quiz App',
    description: 'A Django-based quiz application for multiple choice questions. Features user authentication, quiz management, and score tracking.',
    url: 'https://github.com/sswapnil2/django-quiz-app',
    language: 'Python',
    stars: 123,
    topics: ['Django', 'Python', 'Quiz']
  },
  {
    title: 'Redis in Rust',
    description: 'A Redis implementation built from scratch in Rust. Learning project exploring systems programming and database internals.',
    url: 'https://github.com/sswapnil2/redis-rust',
    language: 'Rust',
    stars: 1,
    topics: ['Rust', 'Redis', 'Systems']
  },
  {
    title: 'Text Summarization',
    description: 'Text summarization using extractive methods with a Flask web interface. Implements NLP techniques for automatic document summarization.',
    url: 'https://github.com/sswapnil2/Text-Summarization',
    language: 'Python',
    stars: 2,
    topics: ['NLP', 'Flask', 'ML']
  }
];
---

<BaseLayout title="Swapnil Shindemeshram">
  <section id="about" class="section hero">
    <p class="greeting">Hello, I'm</p>
    <h1>Swapnil Shindemeshram</h1>
    <p class="tagline">Team Lead (Backend Engineering) at CleverTap</p>
    <p class="intro">
      Software engineer with 7+ years of experience. I enjoy building distributed systems,
      tinkering with new programming languages, and writing about what I learn along the way.
    </p>
  </section>

  <hr />

  <section class="section">
    <h2>What I Do</h2>
    <p>Currently at <strong>CleverTap</strong>, where I:</p>
    <ul class="work-highlights">
      <li>Lead a team of 8 engineers building messaging and engagement platforms</li>
      <li>Own the architecture for inbox, recommendations, and reminders systems</li>
      <li>Ship products handling ~400M messages/month</li>
      <li>Design event-driven systems using Kafka, Redis, and PostgreSQL</li>
    </ul>

    <div class="expertise">
      <span class="expertise-item">Java</span>
      <span class="expertise-item">Spring Boot</span>
      <span class="expertise-item">Kafka</span>
      <span class="expertise-item">Redis</span>
      <span class="expertise-item">PostgreSQL</span>
      <span class="expertise-item">AWS</span>
      <span class="expertise-item">System Design</span>
    </div>
  </section>

  <hr />

  <section id="projects" class="section">
    <h2>Projects</h2>
    <p class="section-intro">
      A selection of side projects and explorations outside of work.
    </p>

    <div class="projects-list">
      {projects.map(project => (
        <article class="project">
          <div class="project-header">
            <h3>
              <a href={project.url} target="_blank" rel="noopener noreferrer">
                {project.title}
              </a>
            </h3>
            <div class="project-meta">
              <span class="language">
                <span class="language-dot" style={`background: ${project.language === 'Python' ? '#3572A5' : project.language === 'Rust' ? '#dea584' : '#666'}`}></span>
                {project.language}
              </span>
              {project.stars > 0 && (
                <span class="stars">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"/>
                  </svg>
                  {project.stars}
                </span>
              )}
            </div>
          </div>
          <p class="project-description">{project.description}</p>
          <div class="project-topics">
            {project.topics.map(topic => (
              <span class="topic">{topic}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <hr />

  <section class="section">
    <h2>Blog</h2>
    <p class="section-intro">
      Thoughts on software engineering, distributed systems, and building products at scale.
    </p>

    {posts.length > 0 ? (
      <div class="posts-list">
        {posts.map(post => (
          <article class="post-preview">
            <a href={`/blog/${post.slug}`}>
              <h3>{post.data.title}</h3>
              <p class="post-excerpt">{post.data.description}</p>
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <p class="text-muted">Coming soon...</p>
    )}

    <a href="/blog" class="view-all">View all posts →</a>
  </section>

  <hr />

  <section id="contact" class="section">
    <h2>Get in Touch</h2>
    <p>
      I'm always interested in hearing about new opportunities, interesting projects,
      or just connecting with fellow engineers. Feel free to reach out.
    </p>
    <p>
      <a href="mailto:smeshram258@gmail.com">smeshram258@gmail.com</a>
    </p>
  </section>
</BaseLayout>

<style>
  .section {
    padding: var(--spacing-lg) 0;
  }

  .hero {
    text-align: center;
    padding: var(--spacing-xl) 0;
  }

  .greeting {
    font-family: var(--font-sans);
    color: var(--color-text-muted);
    font-size: 1rem;
    margin-bottom: var(--spacing-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .hero h1 {
    font-size: 3rem;
    margin-bottom: var(--spacing-sm);
  }

  .tagline {
    font-family: var(--font-sans);
    color: var(--color-accent);
    font-size: 1.1rem;
    font-weight: 500;
    margin-bottom: var(--spacing-lg);
  }

  .intro {
    max-width: 540px;
    margin: 0 auto;
    color: var(--color-text-muted);
  }

  .section-intro {
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-lg);
  }

  .work-highlights {
    list-style: none;
    padding: 0;
    margin: var(--spacing-md) 0;
  }

  .work-highlights li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: var(--spacing-sm);
    color: var(--color-text-muted);
  }

  .work-highlights li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  .expertise {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--spacing-lg);
  }

  .expertise-item {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    background: var(--color-bg-secondary);
    padding: 0.5rem 1rem;
    border-radius: 100px;
    border: 1px solid var(--color-border);
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .project {
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-border-light);
  }

  .project:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xs);
  }

  .project h3 {
    font-size: 1.25rem;
    margin: 0;
  }

  .project h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .project h3 a:hover {
    color: var(--color-accent);
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .language {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .language-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .stars {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .stars svg {
    color: var(--color-text-light);
  }

  .project-description {
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-sm);
    line-height: 1.6;
  }

  .project-topics {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .topic {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-accent);
    background: var(--color-accent-bg);
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .post-preview {
    padding: var(--spacing-md) 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .post-preview:first-child {
    padding-top: 0;
  }

  .post-preview a {
    text-decoration: none;
    display: block;
  }

  .post-preview h3 {
    font-size: 1.25rem;
    margin: 0 0 var(--spacing-xs);
    color: var(--color-text);
    transition: color 0.2s;
  }

  .post-preview:hover h3 {
    color: var(--color-accent);
  }

  .post-excerpt {
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-xs);
    line-height: 1.6;
  }

  .post-preview time {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-text-light);
  }

  .view-all {
    display: inline-block;
    margin-top: var(--spacing-md);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .view-all:hover {
    text-decoration: underline;
  }

  hr {
    margin: var(--spacing-lg) 0;
  }

  @media (max-width: 600px) {
    .hero h1 {
      font-size: 2.25rem;
    }

    .project-header {
      flex-direction: column;
      gap: var(--spacing-xs);
    }

    .project-meta {
      order: -1;
    }
  }
</style>
