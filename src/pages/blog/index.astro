---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog | Swapnil" description="Articles about software development, technology, and more.">
  <section class="blog-header">
    <h1>Blog</h1>
    <p class="text-muted">Thoughts on software development, technology, and more.</p>
  </section>

  {posts.length > 0 ? (
    <ul class="posts-list">
      {posts.map(post => (
        <li class="post-item">
          <article>
            <a href={`/blog/${post.slug}`}>
              <h2 class="post-title">{post.data.title}</h2>
              <p class="post-description">{post.data.description}</p>
              <div class="post-meta">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </time>
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="tags">
                    {post.data.tags.map(tag => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          </article>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty-state">No posts yet. Check back soon!</p>
  )}
</BaseLayout>

<style>
  .blog-header {
    padding: var(--spacing-lg) 0 var(--spacing-md);
  }

  .blog-header h1 {
    margin-bottom: var(--spacing-xs);
  }

  .posts-list {
    list-style: none;
    padding: 0;
  }

  .post-item {
    margin-bottom: var(--spacing-md);
  }

  .post-item article {
    padding: var(--spacing-md);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    transition: border-color 0.2s;
  }

  .post-item article:hover {
    border-color: var(--color-accent);
  }

  .post-item a {
    color: inherit;
    text-decoration: none;
    display: block;
  }

  .post-title {
    font-size: 1.25rem;
    margin: 0 0 var(--spacing-xs);
    transition: color 0.2s;
  }

  .post-item:hover .post-title {
    color: var(--color-accent);
  }

  .post-description {
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-sm);
    line-height: 1.5;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    align-items: center;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .tags {
    display: flex;
    gap: var(--spacing-xs);
  }

  .tag {
    background: #f5f5f5;
    padding: 0.2em 0.6em;
    border-radius: 4px;
    font-size: 0.8rem;
  }

  .empty-state {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--spacing-xl) 0;
  }
</style>
