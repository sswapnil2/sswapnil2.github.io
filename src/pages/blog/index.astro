---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog | Swapnil Shindemeshram" description="Articles about software development, distributed systems, and engineering leadership.">
  <section class="blog-header">
    <h1>Blog</h1>
    <p class="subtitle">
      Thoughts on software engineering, distributed systems, and building products at scale.
    </p>
  </section>

  <hr />

  {posts.length > 0 ? (
    <div class="posts-list">
      {posts.map(post => (
        <article class="post-preview">
          <a href={`/blog/${post.slug}`}>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
            <h2>{post.data.title}</h2>
            <p class="excerpt">{post.data.description}</p>
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="tags">
                {post.data.tags.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </a>
        </article>
      ))}
    </div>
  ) : (
    <div class="empty-state">
      <p>No posts yet. Check back soon!</p>
    </div>
  )}
</BaseLayout>

<style>
  .blog-header {
    text-align: center;
    padding: var(--spacing-lg) 0;
  }

  .blog-header h1 {
    margin-bottom: var(--spacing-sm);
  }

  .subtitle {
    color: var(--color-text-muted);
    max-width: 480px;
    margin: 0 auto;
  }

  hr {
    margin: var(--spacing-lg) 0;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
  }

  .post-preview {
    padding: var(--spacing-lg) 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .post-preview:first-child {
    padding-top: 0;
  }

  .post-preview:last-child {
    border-bottom: none;
  }

  .post-preview a {
    text-decoration: none;
    display: block;
  }

  .post-preview time {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-text-light);
    display: block;
    margin-bottom: var(--spacing-xs);
  }

  .post-preview h2 {
    font-size: 1.5rem;
    margin: 0 0 var(--spacing-sm);
    color: var(--color-text);
    transition: color 0.2s;
  }

  .post-preview:hover h2 {
    color: var(--color-accent);
  }

  .excerpt {
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-sm);
    line-height: 1.7;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-accent);
    background: rgba(26, 137, 23, 0.08);
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
  }

  .empty-state {
    text-align: center;
    padding: var(--spacing-xl) 0;
    color: var(--color-text-muted);
  }
</style>
